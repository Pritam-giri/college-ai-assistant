# =====================================================================
# College AI Assistant — environment template
#
# 1. Copy this file to  .env  (same folder as this file)
# 2. Fill in the real values
# 3. NEVER commit .env  (it is already listed in .gitignore)
# =====================================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# Origin(s) of the React app allowed to call this API (comma-separated).
CLIENT_URL=http://localhost:5173
# Use 1 behind the single Render proxy; leave 0 for direct local development.
TRUST_PROXY_HOPS=0

# ---- Database (connected in Step 3) ----
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/college_assistant
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_assistant

# ---- Authentication ----
# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional independent key for OTP HMACs. If empty, a purpose-derived key is made from JWT_SECRET.
OTP_PEPPER=

# Required only when manually running server/seed/seedAdmin.js
ADMIN_EMAIL=
# Use 16–72 UTF-8 bytes with uppercase, lowercase, number, and special character.
ADMIN_PASSWORD=

# ---- AI provider (needed only for AI-generated chat replies) ----
# Choose gemini or groq. Gemini is the default when a key is configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MongoDB Atlas Vector Search index name. `auto` falls back to local search for development.
RAG_VECTOR_INDEX=college_knowledge_vector
RAG_VECTOR_PROVIDER=auto
RAG_MIN_SCORE=0.42
# Optional alternative provider:
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Email OTP delivery ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Notice attachment storage (required for direct file uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
